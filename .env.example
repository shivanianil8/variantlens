# VariantLens Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External Bioinformatics APIs (Optional API Key for NCBI E-utilities)
